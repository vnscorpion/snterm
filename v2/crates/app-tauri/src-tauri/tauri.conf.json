{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SN Term",
  "version": "2.0.0",
  "identifier": "vn.snterm.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "SN Term",
        "label": "main",
        "width": 1100,
        "height": 700,
        "minWidth": 800,
        "minHeight": 500,
        "center": true,
        "dragDropEnabled": true,
        "backgroundColor": "#1E1E1E",
        "zoomHotkeysEnabled": false,
        "browserExtensionsEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "snterm"
        ],
        "name": "SN Term Session File",
        "description": "SN Term exported VM list",
        "role": "Editor"
      }
    ],
    "shortDescription": "SN Term - SSH/SFTP client",
    "longDescription": "SN Term: quản lý kết nối SSH/SFTP tới máy chủ ảo, giao diện gọn nhẹ 2 cột."
  },
  "plugins": {}
}